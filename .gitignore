# Local .terraform directories
.terraform/
.venv
.idea
.DS_Store

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Local database backup artifacts created by operational scripts
db/backups/

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Cluster-local Git SSH credentials for efs-workspace-init-datamart
config/_clusters/*/efs-workspace-init-datamart/git-ssh-private-key
config/_clusters/*/efs-workspace-init-datamart/git-ssh-public-key
config/_clusters/*/efs-workspace-init-datamart/git-ssh-known-hosts

# Ask Atlas runtime secrets are supplied as cluster/instance overrides.
config/_clusters/*/app-ask-atlas/anthropic-api-key
config/_clusters/*/app-ask-atlas/auth-secret
config/_clusters/*/app-ask-atlas/_instances/*/anthropic-api-key
config/_clusters/*/app-ask-atlas/_instances/*/auth-secret
config/_clusters/*/app-ask-atlas/dropbox-app-key
config/_clusters/*/app-ask-atlas/dropbox-app-secret
config/_clusters/*/app-ask-atlas/dropbox-refresh-token
config/_clusters/*/app-ask-atlas/dropbox-root-namespace-id
config/_clusters/*/app-ask-atlas/_instances/*/dropbox-app-key
config/_clusters/*/app-ask-atlas/_instances/*/dropbox-app-secret
config/_clusters/*/app-ask-atlas/_instances/*/dropbox-refresh-token
config/_clusters/*/app-ask-atlas/_instances/*/dropbox-root-namespace-id

# Atlas Time runtime credentials and saved plans
config/_clusters/*/app-atlas-time/anthropic-api-key
config/_clusters/*/app-atlas-time/_instances/*/anthropic-api-key
*.tfplan
